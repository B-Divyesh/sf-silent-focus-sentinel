{
  "name": "silent-focus-sentinel-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build:cli": "cargo build --release",
    "build:site": "vite build --config site/vite.config.ts && node site/scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:cli && npm run build:site",
    "test:unit": "cargo test",
    "test:e2e": "playwright test",
    "verify:live": "node scripts/verify-live.mjs",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@fontsource/space-grotesk": "5.2.9",
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.30",
    "typescript": "5.9.2",
    "vite": "^7.3.6"
  }
}
